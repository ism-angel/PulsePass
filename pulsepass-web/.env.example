# URL base de la API consumida por el navegador. Es pública por definición (no es un secreto).
# En desarrollo se deja en /api para usar el proxy de Vite (GAP-05).
VITE_API_BASE_URL=/api

# Solo para el servidor de desarrollo de Vite: destino del proxy /api (no llega al bundle).
PULSEPASS_API_PROXY=http://localhost:8080
